  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "ProtectPYME naci\xF3 con la idea de capacitar a los empleados de peque\xF1as
    y medianas empresas en materia de ciberseguridad a trav\xE9s de la interactividad
    y el juego.\nEn el panorama digital actual, las PYMES se han convertido en el
    blanco m\xE1s vulnerable para los ciberdelincuentes, sufriendo constantes ataques
    que ponen en riesgo su estabilidad. Este simulador interactivo fue dise\xF1ado
    como un escudo pr\xE1ctico para transformar a cada miembro del equipo en la primera
    y m\xE1s fuerte l\xEDnea de defensa de la organizaci\xF3n.\n(Desliza hacia abajo
    para ver al equipo de desarrollo)"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
