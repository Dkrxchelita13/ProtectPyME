MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1813623734}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fd4e806ce672da44abff21cd68ad829f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  txtPregunta: {fileID: 1446743114}
  txtOpcionA: {fileID: 1266445245}
  txtOpcionB: {fileID: 1978791415}
  txtOpcionC: {fileID: 796141551}
  txtContador: {fileID: 1517712425}
  btnOpcionA: {fileID: 1049024297}
  btnOpcionB: {fileID: 636267701}
  btnOpcionC: {fileID: 73625061}
  nombreEscenaSiguiente: MiPerfil
  preguntas:
  - idPregunta: P1_PHISH_HABITO
    enunciado: "Recibes un correo urgente de tu banco notificando el bloqueo de tu
      cuenta con un enlace. \xBFQu\xE9 haces?"
    opcionA: Hago clic de inmediato en el enlace para solucionar el problema antes
      de que la bloqueen.
    opcionB: "Reviso la direcci\xF3n del remitente y verifico ingresando directamente
      a la web oficial del banco."
    opcionC: "Le reenv\xEDo el correo a mis compa\xF1eros de trabajo para preguntarles
      si a ellos tambi\xE9n les lleg\xF3."
  - idPregunta: P2_PHISH_CONOCIMIENTO
    enunciado: "\xBFCu\xE1l de los siguientes detalles es la pista m\xE1s clara de
      que un mensaje recibido por WhatsApp es una estafa?"
    opcionA: "Promete un premio o dinero f\xE1cil a cambio de hacer clic en un enlace
      desconocido."
    opcionB: "Proviene de un n\xFAmero de tel\xE9fono que no tengo guardado entre
      mis contactos."
    opcionC: "Tiene errores ortogr\xE1ficos leves en el texto del mensaje."
  - idPregunta: P3_PASS_HABITO
    enunciado: "\xBFC\xF3mo gestionas habitualmente las contrase\xF1as de las plataformas
      que utilizas en tu trabajo?"
    opcionA: "Utilizo la misma contrase\xF1a f\xE1cil de recordar en todos los sistemas
      para no olvidarla."
    opcionB: "Utilizo contrase\xF1as \xFAnicas para cada servicio y me apoyo en un
      gestor de contrase\xF1as."
    opcionC: "Las anoto en una libreta f\xEDsica o en una nota adhesiva pegada a
      mi monitor."
  - idPregunta: P4_PASS_CONOCIMIENTO
    enunciado: "\xBFQu\xE9 caracter\xEDstica hace que una contrase\xF1a sea realmente
      segura frente a ataques automatizados?"
    opcionA: Que tenga al menos 6 caracteres y cambie la letra 'a' por un arroba
      (@).
    opcionB: "Combinar longitud (m\xE1s de 12 caracteres), may\xFAsculas, min\xFAsculas,
      n\xFAmeros y s\xEDmbolos sin palabras obvias."
    opcionC: "Que sea una fecha especial o el nombre de una mascota combinada con
      un n\xFAmero."
  - idPregunta: P5_USB_HABITO
    enunciado: "Encuentras una memoria USB tirada en el estacionamiento o recepci\xF3n
      de la empresa. \xBFCu\xE1l es tu reacci\xF3n?"
    opcionA: "La conecto a mi computadora de trabajo para revisar qu\xE9 archivos
      contiene y devolverla a su due\xF1o."
    opcionB: La entrego directamente al departamento de Sistemas/TI o al responsable
      de seguridad sin conectarla.
    opcionC: "La guardo en mi escritorio para usarla como almacenamiento personal
      despu\xE9s de formatearla."
  - idPregunta: P6_USB_CONOCIMIENTO
    enunciado: "\xBFPor qu\xE9 conectar una USB de origen desconocido a una computadora
      de la empresa representa un riesgo grave?"
    opcionA: "Porque el archivo puede ejecutar un malware de forma autom\xE1tica
      sin que el usuario se d\xE9 cuenta."
    opcionB: "Porque las memorias USB desconocidas suelen da\xF1ar f\xEDsicamente
      las entradas USB del equipo."
    opcionC: "No representa ning\xFAn riesgo si la computadora cuenta con una pantalla
      de bloqueo con clave."
